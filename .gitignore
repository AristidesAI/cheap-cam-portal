# local config (contains your cam credentials)
.env

# generated from template at setup time
mediamtx.yml

# runtime state
.mediamtx.pid
.portal.pid
logs/*
!logs/.gitkeep

# downloaded windows binaries (re-fetched by windows/setup.bat)
windows/bin/*
!windows/bin/.gitkeep

# OS junk
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc
*.pyo
