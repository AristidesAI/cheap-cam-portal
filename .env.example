# cheap-cam-portal config
# Copy this file to ".env" (or run ./setup.sh, which does it for you).
# Lines beginning with # are comments.

# --- camera ---
# The IP address your camera has on your LAN.
# Find it from your router's DHCP client list, or
# from the official app once the cam is provisioned to your WiFi.
CAM_IP=192.168.0.21

# RTSP credentials. For HYW_T729_7_A11C / Fullhan FH8626V100 boards
# the default that worked for me is super / fullhansuper.
# Try those first; if RTSP fails, you'll need to UART in to find
# yours (see HARDWARE-HACK section of the README).
CAM_USER=super
CAM_PASS=fullhansuper

# RTSP port + stream path. /stream1 is the high-res H.264 track.
# /stream0 was rejected on my unit; try it if /stream1 doesn't work.
CAM_PORT=8554
CAM_PATH=stream1

# --- local ports (only change if you have a conflict) ---
# Web portal (the page you open in your browser)
HTTP_PORT=8888
# MediaMTX WebRTC HTTP signaling
WEBRTC_PORT=8889

# --- where files are saved ---
# macOS default:
MOVIES_DIR=~/Movies/cam-portal
SHOTS_DIR=~/Pictures/cam-portal
# Windows default (setup.bat writes these automatically):
#MOVIES_DIR=~/Videos/cam-portal
#SHOTS_DIR=~/Pictures/cam-portal
